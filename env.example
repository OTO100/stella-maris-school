NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-04-01
SANITY_API_READ_TOKEN=
# Required for CMS page documents to load at runtime (create at sanity.io/manage → API → Tokens → Viewer)
# Without this token, inner pages still work from sanity/import/sitemap.ndjson fallbacks.
# Editor token for npm run seed:sitemap (create at sanity.io/manage)
SANITY_API_WRITE_TOKEN=

# Canonical site URL for Open Graph and JSON-LD (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.stellamaris.school.nz

# Set to "false" to hide the small Studio link in the site footer
# NEXT_PUBLIC_SHOW_STUDIO_FOOTER=false
